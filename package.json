{
  "name": "healthy-habits",
  "version": "1.0.0",
  "private": true,
  "description": "Healthy Habits — daily habit tracker (iOS & Android via Capacitor)",
  "scripts": {
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#3E5C49' --iconBackgroundColorDark '#3E5C49' --splashBackgroundColor '#FBF8F2' --splashBackgroundColorDark '#1B211D'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
